{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "node": true,
    "jest": true
  },
  "plugins": ["react", "typescript", "import", "jest"],
  "categories": {
    "correctness": "deny",
    "suspicious": "deny"
  },
  "rules": {
    "no-unused-vars": ["warn", { "varsIgnorePattern": "^_", "argsIgnorePattern": "^_" }],
    "sort-imports": "warn"
  },
  "overrides": [
    {
      "files": ["apps/infra/**"],
      "rules": {
        "no-new": "allow",
        "jest/expect-expect": "allow"
      }
    },
    {
      "files": ["apps/frontend/**"],
      "rules": {
        "react-in-jsx-scope": "allow",
        "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "**/*.svg"] }]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "docs",
    "coverage",
    "cdk.out",
    "apps/frontend/docs"
  ]
}
