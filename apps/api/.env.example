# HTTP port the API listens on
PORT=8080

# Redis connection string
REDIS_URL=redis://localhost:6379

# Secret that authorizes admin endpoints (sent as the `x-admin-key` header).
# Leave empty to disable admin routes.
ADMIN_KEY=

# CORS origin allowed for the browser frontend
FRONTEND_URL=http://localhost:5173

# Session TTL in seconds
SESSION_TTL_SECONDS=600
