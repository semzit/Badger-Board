# Shared secret for admin actions (create/delete board). Entered in the admin
# site's "Admin password" field. Leave empty to disable admin routes.
ADMIN_PASSWORD=

# HTTP port the API listens on
PORT=8080

# Redis connection string
REDIS_URL=redis://localhost:6379

# CORS origin allowed for the browser frontend
FRONTEND_URL=http://localhost:5173

# Session TTL in seconds
SESSION_TTL_SECONDS=600
